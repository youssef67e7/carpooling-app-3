# Vercel: set MongoDB + JWT_SECRET in Project → Settings → Environment Variables (Root Directory = backend).

PORT=3000
JWT_SECRET=change-this-to-a-long-random-string-in-development

# MongoDB Atlas (required)
MONGODB_URI=mongodb+srv://os5027817_db_user:<db_password>@cluster0.bccjvvm.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=weret

# Production: require Atlas (app + web CRUD must appear in Atlas Data Explorer)
MONGODB_ATLAS_REQUIRED=1
MONGODB_FALLBACK_MEMORY=0

# If Atlas blocked temporarily (WARP/VPN), ONLY for offline dev:
# MONGODB_ATLAS_REQUIRED=0
# MONGODB_FALLBACK_MEMORY=1

# File uploads — local disk (default, permanent on your server).
UPLOAD_STORAGE=local
# Optional custom folder (absolute path). Default: backend/uploads
# UPLOAD_ROOT=D:\Games\ReachNative Car\backend\uploads

# Optional: Google Sign-In (verify ID tokens from app)
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_EXPO_CLIENT_ID=

TRUST_PROXY_HOPS=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# Fixed admins — npm run hash-admin-password
# ADMIN_BCRYPT_YOUSSEF=$2a$12$...
# ADMIN_BCRYPT_YOUSSEF1=$2a$12$...

# Phone OTP verification — secret for hashing codes (never commit real value)
PHONE_OTP_SECRET=change-to-long-random-string
SMS_CONSOLE_MODE=1
APP_NAME=WERET
SMS_OTP_LANG=ar
