{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "apps/web/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "website/dist/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/admin-ui(.*)", "dest": "apps/web$1" },
    { "src": "/api/(.*)", "dest": "backend/api/index.js" },
    { "src": "/app(.*)", "dest": "website/dist$1" }
  ]
}
