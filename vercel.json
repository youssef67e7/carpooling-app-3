{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "apps/web/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "website/package.json",
      "use": "@vercel/vite"
    }
  ],
  "routes": [
    { "src": "/admin-ui(.*)", "dest": "apps/web$1" },
    { "src": "/api/(.*)", "dest": "backend/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.html" }
  ]
}
