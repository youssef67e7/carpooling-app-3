# ── Option A: Local dev (same Wi‑Fi as PC) ───────────────────────────────────
# Use localhost — the app rewrites it to your PC LAN IP automatically.
EXPO_PUBLIC_API_URL=http://localhost:3000

# ── Option B: Public / deployed API (works from ANY network) ─────────────────
# Required when the phone is NOT on the same Wi‑Fi as your PC (or you use Expo tunnel).
# Same URL as the admin web panel (see VERCEL.md).
# EXPO_PUBLIC_API_FULL_URL=https://YOUR-PROJECT.vercel.app

# ── Option C: Windows dev proxy (when firewall blocks port 3000) ─────────────
# EXPO_PUBLIC_USE_API_PROXY=1
# EXPO_PUBLIC_API_PROXY_PORT=8090
# Run from repo root: npm run dev:lan

# ── Manual LAN override (if auto-detection fails) ────────────────────────────
# EXPO_PUBLIC_LAN_HOST=192.168.1.6

# Google — Web client ID from Firebase → Authentication → Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Firebase project weret-498023
EXPO_PUBLIC_FIREBASE_PROJECT_ID=weret-498023
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=weret-498023.firebaseapp.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=weret-498023.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=239031460199
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
